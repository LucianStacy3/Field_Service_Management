      "fieldtype": "Data",
      "label": "Email",
      "options": "Email"
    },
    {
      "fieldname": "col_break_customer",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "alt_contact_name",
      "fieldtype": "Data",
      "label": "Alternate Contact"
    },
    {
      "fieldname": "alt_contact_phone",
      "fieldtype": "Data",
      "label": "Alt Phone"
    },
    {
      "fieldname": "capacity_class",
      "fieldtype": "Select",
      "in_list_view": 1,
      "label": "Capacity Class",
      "options": "Light Capacity\nHeavy Capacity",
      "reqd": 1,
      "description": "Light Capacity ≤ 1,000 lb test weight; Heavy Capacity > 1,000 lb"
    },

    {
      "fieldname": "sec_schedule",
      "fieldtype": "Section Break",
      "label": "Service Schedule"
    },
    {
      "default": "Interval",
      "fieldname": "schedule_type",
      "fieldtype": "Select",
      "label": "Schedule Type",
      "options": "Interval\nFixed Months",
      "reqd": 1
    },
    {
      "depends_on": "eval:doc.schedule_type == 'Interval'",
      "fieldname": "interval_months",
      "fieldtype": "Int",
      "label": "Interval (Months)",
      "description": "e.g. 3 = quarterly, 6 = semi-annual, 12 = annual"
    },
    {
      "fieldname": "col_break_schedule",
      "fieldtype": "Column Break"
    },
    {
      "depends_on": "eval:doc.schedule_type == 'Fixed Months'",
      "fieldname": "fixed_months_html",
      "fieldtype": "HTML",
      "label": "Fixed Months (check all that apply)",
      "options": "<p class='text-muted small'>Use the Fixed Months child table on the linked Service Agreement after conversion. Note the selected months in Internal Notes for now.</p>"
    },

    {
      "fieldname": "sec_equipment",
      "fieldtype": "Section Break",
      "label": "Equipment to be Calibrated / Serviced"
    },
    {
      "fieldname": "equipment_items",
      "fieldtype": "Table",
      "label": "Equipment",
      "options": "LCS Service Agreement Quote Item",
      "reqd": 1
    },

    {
      "fieldname": "sec_pricing",
      "fieldtype": "Section Break",
      "label": "Pricing Summary"
    },
    {
      "fieldname": "price_per_service",
      "fieldtype": "Currency",
      "label": "Price per Service Visit",
      "read_only": 1,
      "description": "Sum of all equipment row prices — auto-calculated"
    },
    {
      "fieldname": "col_break_pricing",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "visits_per_year",
      "fieldtype": "Float",
      "label": "Service Visits / Year",
      "read_only": 1,
      "description": "Derived from schedule"
    },
    {
      "fieldname": "annual_total",
      "fieldtype": "Currency",
      "label": "Estimated Annual Total",
      "read_only": 1
    },

    {
      "fieldname": "sec_rates",
      "fieldtype": "Section Break",
      "label": "Preferred Customer Rate Schedule (Emergency / Non-Scheduled)"
    },
    {
      "default": "115.00",
      "fieldname": "rate_regular",
      "fieldtype": "Currency",
      "label": "Regular Hours ($/hr — 1 hr min)"
    },
    {
      "default": "172.50",
      "fieldname": "rate_overtime",
      "fieldtype": "Currency",
      "label": "Overtime Hours ($/hr — 1 hr min)"
    },
    {
      "default": "230.00",
      "fieldname": "rate_holiday",
      "fieldtype": "Currency",
      "label": "Sundays & Holidays ($/hr — 2 hr min)"
    },
    {
      "fieldname": "col_break_rates",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "rates_valid_until",
      "fieldtype": "Date",
      "label": "Rates Valid Until"
    },
    {
      "fieldname": "man_hours",
      "fieldtype": "Float",
      "label": "Est. Man Hours per Visit",
      "description": "For internal costing — not shown on customer-facing print"
    },
    {
      "default": "0",
      "fieldname": "plus_service",
      "fieldtype": "Check",
      "label": "Plus Service"
    },

    {
      "fieldname": "sec_terms",
      "fieldtype": "Section Break",
      "label": "Terms & Conditions"
    },
    {
      "default": "<p>Left Coast Scales will inspect and test with certified weights and standards all assets listed above, according to the schedule stated above.</p>\n<p>All units will be tested with approved standards in accordance with NIST Handbook 44 tolerances set forth by the National Institute of Standards and Technology.</p>\n<p>An emailed report of all \"as found\" and \"as left\" conditions of your assets will be provided after the completion of inspection. All reports and certifications are stored digitally for future reference.</p>\n<p>Any additional services required that are beyond the scope mentioned above, including repairs, parts, installation, and labor, will be performed with your authorization at our agreed-upon labor rates. A certified and trained technician will perform all work.</p>\n<p>Emergency services will be billed using the enclosed rate schedule. This includes mechanical time, travel time, and mileage.</p>\n<p>This agreement will renew automatically at the end of the duration listed. A written notice is required to terminate this service agreement, and must be sent to us at least 30 days prior to the next scheduled service.</p>",
      "fieldname": "terms_html",
      "fieldtype": "Text Editor",
      "label": "Terms"
    },

    {
      "fieldname": "sec_conversion",
      "fieldtype": "Section Break",
      "label": "Conversion"
    },
    {
      "fieldname": "linked_service_agreement",
      "fieldtype": "Link",
      "label": "Linked Service Agreement",
      "options": "LCS Service Agreement",
      "read_only": 1,
      "description": "Set automatically when quote is converted"
    },

