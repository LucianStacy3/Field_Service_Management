{
 "doctype": "Print Format",
 "name": "Left Coast Scales Proposal",
 "doc_type": "Quotation",
 "module": "Field Service Management",
 "print_format_type": "Jinja",
 "standard": "Yes",
 "disabled": 0,
 "default_print_language": "en",
 "html": "<style>\n  .lcs-proposal { font-family: \"Helvetica Neue\", Arial, sans-serif; font-size: 10.5pt; color: #222; }\n  .lcs-proposal table { width: 100%; border-collapse: collapse; }\n  .lcs-proposal .lcs-header-row td { vertical-align: top; padding-bottom: 14px; }\n  .lcs-proposal .lcs-title { font-size: 20pt; font-weight: 700; color: #1B2A4A; margin: 0 0 2px 0; }\n  .lcs-proposal .lcs-subtitle { font-size: 10pt; color: #666; margin: 0; }\n  .lcs-proposal .lcs-meta-table td { padding: 2px 0; font-size: 10pt; }\n  .lcs-proposal .lcs-meta-label { color: #666; padding-right: 10px; white-space: nowrap; }\n  .lcs-proposal .lcs-party-box { background: #F2F4F8; border-radius: 4px; padding: 10px 14px; margin-top: 10px; }\n  .lcs-proposal .lcs-party-box .lcs-party-label { font-size: 8.5pt; text-transform: uppercase; letter-spacing: 0.04em; color: #6c757d; margin-bottom: 3px; }\n  .lcs-proposal .lcs-items-table { margin-top: 18px; }\n  .lcs-proposal .lcs-items-table th { background: #1B2A4A; color: #fff; text-align: left; padding: 7px 8px; font-size: 9pt; font-weight: 600; }\n  .lcs-proposal .lcs-items-table th.lcs-num { text-align: right; }\n  .lcs-proposal .lcs-items-table td { padding: 7px 8px; border-bottom: 1px solid #E3E6EB; font-size: 9.5pt; vertical-align: top; }\n  .lcs-proposal .lcs-items-table td.lcs-num { text-align: right; white-space: nowrap; }\n  .lcs-proposal .lcs-items-table tr:nth-child(even) td { background: #FAFBFC; }\n  .lcs-proposal .lcs-item-desc { color: #555; font-size: 8.75pt; white-space: pre-wrap; margin-top: 2px; }\n  .lcs-proposal .lcs-totals-table { margin-top: 4px; width: 45%; margin-left: 55%; }\n  .lcs-proposal .lcs-totals-table td { padding: 4px 8px; font-size: 9.5pt; }\n  .lcs-proposal .lcs-totals-table td.lcs-num { text-align: right; }\n  .lcs-proposal .lcs-totals-table tr.lcs-grand-total td { border-top: 2px solid #1B2A4A; font-weight: 700; font-size: 11.5pt; color: #1B2A4A; padding-top: 8px; }\n  .lcs-proposal .lcs-exempt-note { font-size: 8.5pt; color: #6c757d; margin-top: 4px; text-align: right; }\n  .lcs-proposal .lcs-terms { margin-top: 24px; padding-top: 12px; border-top: 1px solid #E3E6EB; font-size: 9pt; color: #444; white-space: pre-wrap; }\n  .lcs-proposal .lcs-terms-title { font-size: 9.5pt; font-weight: 700; color: #1B2A4A; margin-bottom: 4px; }\n  .lcs-proposal .lcs-footer { margin-top: 24px; font-size: 8.5pt; color: #999; text-align: center; }\n</style>\n\n<div class=\"lcs-proposal\">\n\n  {% if letter_head %}\n  <div class=\"lcs-letterhead\">{{ letter_head }}</div>\n  {% endif %}\n\n  <table class=\"lcs-header-row\">\n    <tr>\n      <td style=\"width: 60%\">\n        <p class=\"lcs-title\">Proposal</p>\n        <p class=\"lcs-subtitle\">\n          {{ doc.company }}\n          {% if doc.custom_branch %} \u2014 {{ doc.custom_branch }} Branch{% endif %}\n        </p>\n      </td>\n      <td style=\"width: 40%\">\n        <table class=\"lcs-meta-table\">\n          <tr><td class=\"lcs-meta-label\">Quotation #</td><td>{{ doc.name }}</td></tr>\n          <tr><td class=\"lcs-meta-label\">Date</td><td>{{ frappe.utils.formatdate(doc.transaction_date) }}</td></tr>\n          {% if doc.valid_till %}\n          <tr><td class=\"lcs-meta-label\">Valid Until</td><td>{{ frappe.utils.formatdate(doc.valid_till) }}</td></tr>\n          {% endif %}\n          {% if doc.order_type %}\n          <tr><td class=\"lcs-meta-label\">Type</td><td>{{ doc.order_type }}</td></tr>\n          {% endif %}\n        </table>\n      </td>\n    </tr>\n  </table>\n\n  <div class=\"lcs-party-box\">\n    <div class=\"lcs-party-label\">Prepared For</div>\n    <div><strong>{{ doc.customer_name or doc.party_name }}</strong></div>\n    {% if doc.address_display %}\n    <div>{{ doc.address_display }}</div>\n    {% endif %}\n    {% if doc.contact_display %}\n    <div>{{ doc.contact_display }}</div>\n    {% endif %}\n  </div>\n\n  <table class=\"lcs-items-table\">\n    <thead>\n      <tr>\n        <th style=\"width: 4%\">#</th>\n        <th style=\"width: 46%\">Item &amp; Description</th>\n        <th class=\"lcs-num\" style=\"width: 10%\">Qty</th>\n        <th class=\"lcs-num\" style=\"width: 18%\">Rate</th>\n        <th class=\"lcs-num\" style=\"width: 22%\">Amount</th>\n      </tr>\n    </thead>\n    <tbody>\n      {% for item in doc.items %}\n      <tr>\n        <td>{{ loop.index }}</td>\n        <td>\n          <strong>{{ item.item_name or item.item_code }}</strong>\n          {% if item.description %}\n          <div class=\"lcs-item-desc\">{{ item.description }}</div>\n          {% endif %}\n        </td>\n        <td class=\"lcs-num\">{{ frappe.utils.fmt_money(item.qty, precision=0) if item.qty == item.qty|int else item.qty }} {{ item.uom or \"\" }}</td>\n        <td class=\"lcs-num\">{{ frappe.utils.fmt_money(item.rate, currency=doc.currency) }}</td>\n        <td class=\"lcs-num\">{{ frappe.utils.fmt_money(item.amount, currency=doc.currency) }}</td>\n      </tr>\n      {% endfor %}\n    </tbody>\n  </table>\n\n  <table class=\"lcs-totals-table\">\n    <tr>\n      <td>Subtotal</td>\n      <td class=\"lcs-num\">{{ frappe.utils.fmt_money(doc.net_total, currency=doc.currency) }}</td>\n    </tr>\n    {% if doc.exempt_from_sales_tax %}\n    <tr>\n      <td colspan=\"2\" class=\"lcs-exempt-note\">Tax exempt</td>\n    </tr>\n    {% else %}\n      {% for tax in doc.taxes %}\n      <tr>\n        <td>{{ tax.description }}</td>\n        <td class=\"lcs-num\">{{ frappe.utils.fmt_money(tax.tax_amount, currency=doc.currency) }}</td>\n      </tr>\n      {% endfor %}\n    {% endif %}\n    {% if doc.discount_amount %}\n    <tr>\n      <td>Discount</td>\n      <td class=\"lcs-num\">-{{ frappe.utils.fmt_money(doc.discount_amount, currency=doc.currency) }}</td>\n    </tr>\n    {% endif %}\n    <tr class=\"lcs-grand-total\">\n      <td>Total</td>\n      <td class=\"lcs-num\">{{ frappe.utils.fmt_money(doc.grand_total, currency=doc.currency) }}</td>\n    </tr>\n  </table>\n\n  {% if doc.terms %}\n  <div class=\"lcs-terms\">\n    <div class=\"lcs-terms-title\">Terms &amp; Conditions</div>\n    {{ doc.terms }}\n  </div>\n  {% endif %}\n\n  <div class=\"lcs-footer\">\n    This proposal is generated by {{ doc.company }}\n    {% if doc.custom_branch %}\u2014 {{ doc.custom_branch }} Branch{% endif %}.\n    Thank you for the opportunity to earn your business.\n  </div>\n\n</div>",
 "css": "",
 "font": "Default",
 "font_size": 0,
 "margin_top": 15.0,
 "margin_bottom": 15.0,
 "margin_left": 15.0,
 "margin_right": 15.0,
 "page_number": "Hide",
 "align_labels_right": 0,
 "show_section_headings": 0,
 "line_breaks": 0,
 "absolute_value": 0,
 "raw_printing": 0,
